        {
            "codigo": "PRYC.2.1",
            "descripcion": "Desarrollar la capacidad de abstracción, producir programas informáticos funcionales e integrarse en un equipo de desarrollo de software que sea capaz de afrontar proyectos acordes al nivel de desarrollo del alumnado, fomentando sus habilidades sociales y aplicando la creatividad."
        },
        {
            "codigo": "PRYC.2.2",
            "descripcion": "Recopilar y procesar datos que ayuden en la resolución de un problema, analizando cómo su almacenamiento, transmisión y presentación se benefician de la manipulación computacional."
        },
        {
            "codigo": "PRYC.2.3",
            "descripcion": "Desarrollar aplicaciones web sencillas con acceso a una base de datos utilizando html, css y un lenguaje de script, elaborando páginas web con el fin de programar de manera accesible."
        },
        {
            "codigo": "PRYC.2.4",
            "descripcion": "Explorar la computación física, construyendo un sistema hardware y software que interactúe con el medio físico, detectando y respondiendo a cambios en el mundo real, para comprender las diferencias entre los mundos digital y analógico."
        }
