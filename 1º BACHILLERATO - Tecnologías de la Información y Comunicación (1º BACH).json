{
    "titulo": "1º BACHILLERATO - Tecnologías de la Información y Comunicación (1º BACH)",
    "referencia": "TICO.1",
    "competencias_especificas": [
        {
            "codigo": "TICO.1.1",
            "descripcion": "Reconocer el proceso de transformación como agente de cambio, analizando aspectos positivos y negativos de dicho proceso para entender el papel principal de las tecnologías de la información y la comunicación en la sociedad actual, su impacto en los ámbitos social, económico y cultural, y su importancia en la innovación y el empleo."
        },
        {
            "codigo": "TICO.1.2",
            "descripcion": "Configurar ordenadores y equipos informáticos, utilizando de forma segura, responsable y respetuosa dichos dispositivos, para comprender el funcionamiento de los componentes hardware y software que conforman ordenadores y equipos digitales."
        },
        {
            "codigo": "TICO.1.3",
            "descripcion": "Usar, seleccionar y combinar múltiples aplicaciones informáticas, atendiendo a cuestiones de diseño, usabilidad y accesibilidad, incluyendo la creación de un proyecto web, para crear producciones digitales que cumplan unos objetivos determinados."
        },
        {
            "codigo": "TICO.1.4",
            "descripcion": "Comprender el funcionamiento de Internet y de las tecnologías de búsqueda, analizando de forma crítica los contenidos publicados y fomentando un uso compartido de la información, para permitir la producción colaborativa y la difusión de conocimiento."
        },
        {
            "codigo": "TICO.1.5",
            "descripcion": "Comprender qué es un algoritmo y cómo son implementados en forma de programa, analizando y aplicando los principios de la ingeniería del software, para desarrollar y depurar aplicaciones informáticas y resolver problemas."
        }
    ],
    "criterios_evaluacion": [
        {
            "referencia": "TICO.1.1.1",
