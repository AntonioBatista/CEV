            "saberes_relacionados": [
                "TICO.1.B.2."
            ]
        },
        {
            "referencia": "TICO.1.3.1",
            "descripcion": "Seleccionar y utilizar de manera combinada aplicaciones informáticas para la creación de contenidos digitales y la resolución de problemas específicos.",
